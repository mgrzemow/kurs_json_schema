{
  "type": "object",
  "properties": {
    "numer": {
      "type": "string",
      "pattern": "^ZAM-[0-9]{4}-[0-9]{6}$"
    },
    "klient": {
      "type": "string",
      "minLength": 1
    },
    "adresDostawy": {
      "type": "object",
      "properties": {
        "ulica": {
          "type": "string"
        },
        "miasto": {
          "type": "string"
        },
        "kodPocztowy": {
          "type": "string",
          "pattern": "^[0-9]{2}-[0-9]{3}$"
        }
      },
      "required": [
        "ulica",
        "miasto",
        "kodPocztowy"
      ]
    },
    "sciezkaFaktury": {
      "type": "string",
      "pattern": "^C:\\\\faktury\\\\[^\\\\]+\\.pdf$"
    },
    "pozycje": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ean": {
            "type": "string",
            "pattern": "^[0-9]{13}$"
          },
          "ilosc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "cena": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "ean",
          "ilosc",
          "cena"
        ]
      }
    }
  },
  "required": [
    "numer",
    "klient",
    "adresDostawy",
    "pozycje"
  ]
}
